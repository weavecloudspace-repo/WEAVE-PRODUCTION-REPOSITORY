{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "generate:pwa-icons": "node scripts/generatePwaIcons.mjs",
    "predev": "npm run generate:pwa-icons",
    "predev:staging": "npm run generate:pwa-icons",
    "dev": "vite",
    "dev:staging": "vite --mode staging",
    "prebuild": "npm run generate:pwa-icons",
    "prebuild:staging": "npm run generate:pwa-icons",
    "prebuild:production": "npm run generate:pwa-icons",
    "build": "vite build",
    "build:staging": "vite build --mode staging",
    "build:production": "vite build --mode production",
    "lint": "eslint .",
    "lint-fix": "eslint . --fix",
    "pretest": "npm run generate:pwa-icons",
    "test": "node --test",
    "test:unit": "node --test test/unit/*.test.js",
    "test:integration": "node --test test/integration/*.test.js",
    "test:contracts": "node scripts/verifyFrontendBackendContracts.mjs",
    "preview": "vite preview",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "katex": "^0.19.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.16.0",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.17",
    "vite": "^8.0.12"
  }
}
